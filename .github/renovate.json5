{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>scottames/renovate:default.json5',
  ],
  schedule: [
    '* * * * *', // explicitly unrestricted
  ],
  minimumReleaseAge: null,
  automerge: true,
  packageRules: [
    {
      matchPackageNames: ['herdrdev/herdr-app', 'herdrdev/herdr-core'],
      groupName: 'Herdr RPMs',
    },
    {
      matchPackageNames: ['anomalyco/hokum'],
      groupName: 'hokum RPMs',
    },
    {
      description: 'Keep spec-guards Fedora container aligned with .github/spec-build-targets.json',
      matchManagers: ['github-actions'],
      matchDatasources: ['docker'],
      matchFileNames: ['.github/workflows/spec-guards.yaml'],
      matchPackageNames: ['fedora'],
      allowedVersions: '/^45$/',
    },
    {
      matchPackageNames: ['anomalyco/hex'],
      groupName: 'hex RPMs',
    },
  ],
  customDatasources: {
    'herdr-app-x86_64': {
      defaultRegistryUrlTemplate: 'https://releases.herdr.dev/app/latest.json',
      format: 'json',
      transformTemplates: [
        '{"releases":$contains($string(version),/^[0-9]+[.][0-9]+[.][0-9]+$/) and $contains($string(targets."linux-x86_64".sha256),/^[0-9a-f]{64}$/) ? [{"version":version & "+" & targets."linux-x86_64".sha256,"changelogContent":notes,"changelogUrl":"https://github.com/herdrdev/herdr-app/blob/v" & version & "/CHANGELOG.md"}] : [],"sourceUrl":"https://github.com/herdrdev/herdr-app"}',
      ],
    },
    'herdr-app-aarch64': {
      defaultRegistryUrlTemplate: 'https://releases.herdr.dev/app/latest.json',
      format: 'json',
      transformTemplates: [
        '{"releases":$contains($string(version),/^[0-9]+[.][0-9]+[.][0-9]+$/) and $contains($string(targets."linux-aarch64".sha256),/^[0-9a-f]{64}$/) ? [{"version":version & "+" & targets."linux-aarch64".sha256,"changelogContent":notes,"changelogUrl":"https://github.com/herdrdev/herdr-app/blob/v" & version & "/CHANGELOG.md"}] : [],"sourceUrl":"https://github.com/herdrdev/herdr-app"}',
      ],
    },
    'herdr-core-x86_64': {
      defaultRegistryUrlTemplate: 'https://releases.herdr.dev/core/latest.json',
      format: 'json',
      transformTemplates: [
        '{"releases":$contains($string(version),/^[0-9]+[.][0-9]+[.][0-9]+$/) and $contains($string(targets."linux-x86_64".sha256),/^[0-9a-f]{64}$/) ? [{"version":version & "+" & targets."linux-x86_64".sha256,"changelogContent":notes,"changelogUrl":"https://github.com/herdrdev/herdr-core/blob/v" & version & "/CHANGELOG.md"}] : [],"sourceUrl":"https://github.com/herdrdev/herdr-core"}',
      ],
    },
    'herdr-core-aarch64': {
      defaultRegistryUrlTemplate: 'https://releases.herdr.dev/core/latest.json',
      format: 'json',
      transformTemplates: [
        '{"releases":$contains($string(version),/^[0-9]+[.][0-9]+[.][0-9]+$/) and $contains($string(targets."linux-aarch64".sha256),/^[0-9a-f]{64}$/) ? [{"version":version & "+" & targets."linux-aarch64".sha256,"changelogContent":notes,"changelogUrl":"https://github.com/herdrdev/herdr-core/blob/v" & version & "/CHANGELOG.md"}] : [],"sourceUrl":"https://github.com/herdrdev/herdr-core"}',
      ],
    },
    'hokum-rpm-x64': {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/anomalyco/hokum/releases',
      format: 'json',
      transformTemplates: [
        '($asset:=function($r){($r.assets[name="hokum-" & $replace($r.tag_name,/^v/,"") & "-linux-x64.rpm" and $contains($string(digest),/^sha256:[0-9a-f]{64}$/)])[0]};{"releases":$append([],$map($filter($,function($r){$contains($r.tag_name,/^v/) and $not($r.draft) and $not($r.prerelease) and $exists($asset($r))}),function($r){($a:=$asset($r);{"version":$replace($r.tag_name,/^v/,""),"releaseTimestamp":$r.published_at,"changelogUrl":$r.html_url,"changelogContent":$r.body,"digest":$replace($a.digest,/^sha256:/,"")})})),"sourceUrl":"https://github.com/anomalyco/hokum"})',
      ],
    },
    'hokum-rpm-arm64': {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/anomalyco/hokum/releases',
      format: 'json',
      transformTemplates: [
        '($asset:=function($r){($r.assets[name="hokum-" & $replace($r.tag_name,/^v/,"") & "-linux-arm64.rpm" and $contains($string(digest),/^sha256:[0-9a-f]{64}$/)])[0]};{"releases":$append([],$map($filter($,function($r){$contains($r.tag_name,/^v/) and $not($r.draft) and $not($r.prerelease) and $exists($asset($r))}),function($r){($a:=$asset($r);{"version":$replace($r.tag_name,/^v/,""),"releaseTimestamp":$r.published_at,"changelogUrl":$r.html_url,"changelogContent":$r.body,"digest":$replace($a.digest,/^sha256:/,"")})})),"sourceUrl":"https://github.com/anomalyco/hokum"})',
      ],
    },
    'monstar-source': {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/rockorager/monstar/releases',
      format: 'json',
      transformTemplates: [
        '($sourceName:=function($release){"monstar-" & $replace($release.tag_name,/^v/,"") & "-source.tar.gz"};$sourceAsset:=function($release){($filter($release.assets,function($asset){$asset.name=$sourceName($release) and $contains($asset.digest,/^sha256:[0-9a-f]{64}$/)}))[0]};{"releases":$append([],$map($filter($,function($release){$contains($release.tag_name,/^v/) and $not($release.draft) and $not($release.prerelease) and $exists($sourceAsset($release))}),function($release){($version:=$replace($release.tag_name,/^v/,"");$asset:=$sourceAsset($release);{"version":$version,"releaseTimestamp":$release.published_at,"changelogUrl":$release.html_url,"sourceUrl":$release.html_url,"digest":$replace($asset.digest,/^sha256:/,"")})})),"sourceUrl":"https://github.com/rockorager/monstar","homepage":"https://github.com/rockorager/monstar"})',
      ],
    },
    'voxtype-rpm': {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/peteonrails/voxtype/releases',
      format: 'json',
      transformTemplates: [
        '($rpmName:=function($release){"voxtype-" & $replace($release.tag_name,/^v/,"") & "-1.x86_64.rpm"};$rpmAsset:=function($release){($filter($release.assets,function($asset){$asset.name=$rpmName($release) and $contains($asset.digest,/^sha256:[0-9a-f]{64}$/)}))[0]};{"releases":$map($filter($,function($release){$exists($rpmAsset($release))}),function($release){($version:=$replace($release.tag_name,/^v/,"");$asset:=$rpmAsset($release);{"version":$version,"releaseTimestamp":$release.published_at,"changelogUrl":$release.html_url,"sourceUrl":$release.html_url,"digest":$replace($asset.digest,/^sha256:/,"")})}),"sourceUrl":"https://github.com/peteonrails/voxtype","homepage":"https://voxtype.io"})',
      ],
    },
    'hex-rpm-x64': {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/anomalyco/hex/releases',
      format: 'json',
      transformTemplates: [
        '($asset:=function($r){($r.assets[name="hex-" & $replace($r.tag_name,/^v/,"") & "-linux-x64.rpm" and $contains($string(digest),/^sha256:[0-9a-f]{64}$/)])[0]};{"releases":$append([],$map($filter($,function($r){$contains($r.tag_name,/^v/) and $not($r.draft) and $not($r.prerelease) and $exists($asset($r))}),function($r){($a:=$asset($r);{"version":$replace($r.tag_name,/^v/,""),"releaseTimestamp":$r.published_at,"changelogUrl":$r.html_url,"changelogContent":$r.body,"digest":$replace($a.digest,/^sha256:/,"")})})),"sourceUrl":"https://github.com/anomalyco/hex"})',
      ],
    },
    'hex-rpm-arm64': {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/anomalyco/hex/releases',
      format: 'json',
      transformTemplates: [
        '($asset:=function($r){($r.assets[name="hex-" & $replace($r.tag_name,/^v/,"") & "-linux-arm64.rpm" and $contains($string(digest),/^sha256:[0-9a-f]{64}$/)])[0]};{"releases":$append([],$map($filter($,function($r){$contains($r.tag_name,/^v/) and $not($r.draft) and $not($r.prerelease) and $exists($asset($r))}),function($r){($a:=$asset($r);{"version":$replace($r.tag_name,/^v/,""),"releaseTimestamp":$r.published_at,"changelogUrl":$r.html_url,"changelogContent":$r.body,"digest":$replace($a.digest,/^sha256:/,"")})})),"sourceUrl":"https://github.com/anomalyco/hex"})',
      ],
    },
    'zennotes-rpm': {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/ZenNotes/zennotes/releases',
      format: 'json',
      transformTemplates: [
        '($rpmName:=function($release){"ZenNotes-" & $replace($release.tag_name,/^v/,"") & "-linux-x86_64.rpm"};$rpmAsset:=function($release){($filter($release.assets,function($asset){$asset.name=$rpmName($release) and $contains($asset.digest,/^sha256:[0-9a-f]{64}$/)}))[0]};{"releases":$map($filter($,function($release){$contains($release.tag_name,/^v/) and $exists($rpmAsset($release))}),function($release){($version:=$replace($release.tag_name,/^v/,"");$asset:=$rpmAsset($release);{"version":$version,"releaseTimestamp":$release.published_at,"changelogUrl":$release.html_url,"sourceUrl":$release.html_url,"digest":$replace($asset.digest,/^sha256:/,"")})}),"sourceUrl":"https://github.com/ZenNotes/zennotes","homepage":"https://github.com/ZenNotes/zennotes"})',
      ],
    },
  },
  customManagers: [
    // latest.json has no old digests. Track version+sha256 as one SemVer value,
    // then write its parts together. Build metadata does not affect version order.
    {
      customType: 'regex',
      managerFilePatterns: ['/^herdrdev/herdr-app\\.spec$/'],
      matchStrings: [
        '%global upstream_arch (?<depType>x86_64|aarch64)\\n%global upstream_sha256 (?<checksum>[0-9a-f]{64})\\nVersion:\\s*(?<currentValue>\\S+)',
      ],
      currentValueTemplate: '{{{currentValue}}}+{{{checksum}}}',
      autoReplaceStringTemplate: '%global upstream_arch {{{depType}}}\n%global upstream_sha256 {{{replace "^.*\\+" "" newValue}}}\nVersion:        {{{replace "\\+.*$" "" newValue}}}',
      depNameTemplate: 'herdrdev/herdr-app',
      datasourceTemplate: 'custom.herdr-app-{{{depType}}}',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^herdrdev/herdr-core\\.spec$/'],
      matchStrings: [
        '%global upstream_arch (?<depType>x86_64|aarch64)\\n%global upstream_sha256 (?<checksum>[0-9a-f]{64})\\nVersion:\\s*(?<currentValue>\\S+)',
      ],
      currentValueTemplate: '{{{currentValue}}}+{{{checksum}}}',
      autoReplaceStringTemplate: '%global upstream_arch {{{depType}}}\n%global upstream_sha256 {{{replace "^.*\\+" "" newValue}}}\nVersion:        {{{replace "\\+.*$" "" newValue}}}',
      depNameTemplate: 'herdrdev/herdr-core',
      datasourceTemplate: 'custom.herdr-core-{{{depType}}}',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^anomalyco/hokum\\.spec$/'],
      matchStrings: [
        '%global upstream_arch (?<depType>x64|arm64)\\n%global upstream_rpm_sha256 (?<currentDigest>[0-9a-f]{64})\\nVersion:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'anomalyco/hokum',
      datasourceTemplate: 'custom.hokum-rpm-{{{depType}}}',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^ghostty/ghostty\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'ghostty-org/ghostty',
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^ghostty/gtk4-layer-shell\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'wmww/gtk4-layer-shell',
      datasourceTemplate: 'github-tags',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/aquamarine\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/aquamarine',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hypridle\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hypridle',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hyprgraphics\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hyprgraphics',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hyprlang\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hyprlang',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hyprland-protocols\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hyprland-protocols',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hyprlock\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hyprlock',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hyprpaper\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hyprpaper',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hyprpicker\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hyprpicker',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hyprtoolkit\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hyprtoolkit',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hyprutils\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hyprutils',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hyprwayland-scanner\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hyprwayland-scanner',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^hypr/hyprwire\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'hyprwm/hyprwire',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^awww/awww\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'LGFae/awww',
      datasourceTemplate: 'forgejo-releases',
      registryUrlTemplate: 'https://codeberg.org',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^mise/mise\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'jdx/mise',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^monstar/monstar\\.spec$/',
      ],
      matchStrings: [
        '(?<checksumPrefix>%global\\s+upstream_source_sha256\\s+)(?<currentDigest>[0-9a-f]{64})(?<versionPrefix>\\n(?:.*\\n)*?Version:\\s*)(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'rockorager/monstar',
      datasourceTemplate: 'custom.monstar-source',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^vicinae/cmark-gfm\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'github/cmark-gfm',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^vicinae/glaze\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'stephenberry/glaze',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^vicinae/vicinae\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'vicinaehq/vicinae',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^voxtype/voxtype\\.spec$/',
      ],
      matchStrings: [
        '(?<checksumPrefix>%global\\s+upstream_rpm_sha256\\s+)(?<currentDigest>[0-9a-f]{64})(?<versionPrefix>\\n(?:.*\\n)*?Version:\\s*)(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'peteonrails/voxtype',
      datasourceTemplate: 'custom.voxtype-rpm',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^zennotes/zennotes\\.spec$/',
      ],
      matchStrings: [
        '(?<checksumPrefix>%global\\s+upstream_rpm_sha256\\s+)(?<currentDigest>[0-9a-f]{64})(?<versionPrefix>\\n(?:.*\\n)*?Version:\\s*)(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'ZenNotes/zennotes',
      datasourceTemplate: 'custom.zennotes-rpm',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['/^anomalyco/hex\\.spec$/'],
      matchStrings: [
        '%global upstream_arch (?<depType>x64|arm64)\\n%global upstream_rpm_sha256 (?<currentDigest>[0-9a-f]{64})\\nVersion:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'anomalyco/hex',
      datasourceTemplate: 'custom.hex-rpm-{{{depType}}}',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^zen-browser/.*\\.spec$/',
      ],
      matchStrings: [
        'Version:\\s*(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'zen-browser/desktop',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?b?$',
    },
  ],
}
