[Unit]
Description=Xremap system input remapper
Documentation=https://github.com/xremap/xremap/blob/v0.15.18/doc/running_as_system_service.md
After=systemd-udevd.service systemd-logind.service
ConditionPathExists=/etc/xremap/config.yml

[Service]
ExecStart=/usr/bin/xremap --desktop=socket --watch=device --no-window-logging /etc/xremap/config.yml
User=xremap
Group=xremap
SupplementaryGroups=input
RuntimeDirectory=xremap
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Environment=RUST_LOG=warn
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
