[Unit]
Description=Xremap user input remapper
Documentation=https://github.com/xremap/xremap
PartOf=graphical-session.target
After=graphical-session.target
Conflicts=xremap-bridge.service
ConditionPathExists=%h/.config/xremap/config.yml

[Service]
ExecStart=/usr/bin/xremap --watch=device --no-window-logging %h/.config/xremap/config.yml
Environment=RUST_LOG=warn
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
